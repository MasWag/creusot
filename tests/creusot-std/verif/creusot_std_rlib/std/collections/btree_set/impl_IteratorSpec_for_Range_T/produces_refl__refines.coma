(* <std::collections::btree_set::Range<'a, T> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Range_T

type t_T

function view_Range_T (self: t_Range_T) : Seq.seq t_T

predicate produces_Range_T (self: t_Range_T) (visited: Seq.seq t_T) (tl: t_Range_T) =
  view_Range_T self = Seq.(++) visited (view_Range_T tl)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Range_T. forall result: (). produces_Range_T self (Seq.empty: Seq.seq t_T) self
      -> produces_Range_T self (Seq.empty: Seq.seq t_T) self
