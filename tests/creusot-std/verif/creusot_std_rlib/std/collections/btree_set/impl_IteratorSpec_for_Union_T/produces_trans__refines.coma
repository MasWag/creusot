(* <std::collections::btree_set::Union<'a, T> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Union_T

type t_T

function view_Union_T (self: t_Union_T) : Seq.seq t_T

predicate produces_Union_T (self: t_Union_T) (visited: Seq.seq t_T) (tl: t_Union_T) =
  view_Union_T self = Seq.(++) visited (view_Union_T tl)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall a: t_Union_T, ab: Seq.seq t_T, b: t_Union_T, bc: Seq.seq t_T, c: t_Union_T. produces_Union_T a ab b
    -> produces_Union_T b bc c
    -> produces_Union_T a ab b
    /\ produces_Union_T b bc c
    /\ (forall result: (). produces_Union_T a (Seq.(++) ab bc) c -> produces_Union_T a (Seq.(++) ab bc) c)
