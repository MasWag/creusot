(* <std::collections::btree_set::Union<'a, T> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Union_T

type t_T

function view_Union_T (self: t_Union_T) : Seq.seq t_T

predicate produces_Union_T (self: t_Union_T) (visited: Seq.seq t_T) (tl: t_Union_T) =
  view_Union_T self = Seq.(++) visited (view_Union_T tl)

function concat_empty_ref_T (self: Seq.seq t_T) : ()

axiom concat_empty_ref_T_spec: forall self: Seq.seq t_T. Seq.(++) self (Seq.empty: Seq.seq t_T) = self

axiom concat_empty_ref_T_spec'0: forall self: Seq.seq t_T. Seq.(++) (Seq.empty: Seq.seq t_T) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Union_T

function produces_refl_Union_T (self: t_Union_T) : ()

goal vc_produces_refl_Union_T:
  [@stop_split] [@expl:produces_refl ensures] produces_Union_T self (Seq.empty: Seq.seq t_T) self
