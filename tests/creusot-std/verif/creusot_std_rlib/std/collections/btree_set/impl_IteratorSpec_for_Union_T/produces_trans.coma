(* <std::collections::btree_set::Union<'a, T> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Union_T

type t_T

function view_Union_T (self: t_Union_T) : Seq.seq t_T

predicate produces_Union_T (self: t_Union_T) (visited: Seq.seq t_T) (tl: t_Union_T) =
  view_Union_T self = Seq.(++) visited (view_Union_T tl)

function concat_assoc_ref_T (self: Seq.seq t_T) (other1: Seq.seq t_T) (other2: Seq.seq t_T) : ()

axiom concat_assoc_ref_T_spec:
  forall self: Seq.seq t_T, other1: Seq.seq t_T, other2: Seq.seq t_T. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Union_T

constant ab : Seq.seq t_T

constant b : t_Union_T

constant bc : Seq.seq t_T

constant c : t_Union_T

function produces_trans_Union_T (a: t_Union_T) (ab: Seq.seq t_T) (b: t_Union_T) (bc: Seq.seq t_T) (c: t_Union_T) : ()

goal vc_produces_trans_Union_T: produces_Union_T a ab b
  -> produces_Union_T b bc c -> ([@stop_split] [@expl:produces_trans ensures] produces_Union_T a (Seq.(++) ab bc) c)
